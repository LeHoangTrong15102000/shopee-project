{
  "name": "@shopee/api",
  "version": "1.0.0",
  "private": true,
  "main": "build/src/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "nodemon --files -r tsconfig-paths/register src/index.ts",
    "build": "tsc --project ./ && tsc-alias",
    "prod": "tsc --project ./ && tsc-alias && node ./build/src/index.js production",
    "import-data": "npx ts-node -r tsconfig-paths/register scripts/import-data.ts",
    "backup-data": "npx ts-node -r tsconfig-paths/register scripts/backup-data.ts",
    "test-connection": "npx ts-node -r tsconfig-paths/register scripts/test-connection.ts",
    "test-images": "npx ts-node -r tsconfig-paths/register scripts/test-images.ts",
    "debug-api": "npx ts-node -r tsconfig-paths/register scripts/debug-api.ts",
    "fix-frontend-images": "npx ts-node -r tsconfig-paths/register scripts/fix-frontend-images.ts",
    "simple-debug": "npx ts-node -r tsconfig-paths/register scripts/simple-debug.ts",
    "final-debug": "npx ts-node -r tsconfig-paths/register scripts/final-debug.ts",
    "frontend-fix-complete": "npx ts-node -r tsconfig-paths/register scripts/frontend-fix-complete.ts",
    "safe-import": "pnpm run backup-data && pnpm run import-data",
    "test-chatbot": "npx ts-node -r tsconfig-paths/register scripts/test-chatbot.ts",
    "chatbot-health": "curl -s http://localhost:4000/analytics/health | json_pp",
    "seed-users": "npx ts-node -r tsconfig-paths/register scripts/seed-users.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@anthropic-ai/sdk": "^0.55.0",
    "@types/compression": "^1.8.1",
    "@types/shelljs": "^0.8.15",
    "ai": "^4.3.16",
    "chalk": "^4.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-validator": "^7.2.0",
    "formidable": "^3.5.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.8.4",
    "mv": "^2.1.1",
    "nanoid": "^5.1.5",
    "rate-limiter-flexible": "^11.0.1",
    "shelljs": "^0.8.5",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.3",
    "xstate": "^5.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/formidable": "^3.4.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.12.1"
}
