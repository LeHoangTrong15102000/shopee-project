{
  "name": "shopee-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shopee-admin/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit", "vite build"],
        "cwd": "apps/shopee-admin",
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --port 4001",
        "cwd": "apps/shopee-admin"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --ext ts,tsx src/",
        "cwd": "apps/shopee-admin"
      }
    },
    "prettier": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"src/**/(*.tsx|*.ts|*.css|*.scss)\"",
        "cwd": "apps/shopee-admin"
      }
    },
    "prettier:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"src/**/(*.tsx|*.ts|*.css|*.scss)\"",
        "cwd": "apps/shopee-admin"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/shopee-admin"
      }
    }
  }
}
