# =============================================================================
# shopee-admin — Multi-stage Dockerfile
# Build context: monorepo root (docker build -f apps/shopee-admin/Dockerfile .)
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: deps — install workspace dependencies
# -----------------------------------------------------------------------------
FROM node:20-alpine AS deps

WORKDIR /app

# Enable corepack and activate the exact pnpm version pinned in the workspace
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

# Copy workspace manifests first so this layer is cached when only source changes
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/shopee-admin/package.json ./apps/shopee-admin/
COPY libs/shared-constants/package.json ./libs/shared-constants/
COPY libs/shared-types/package.json ./libs/shared-types/
COPY libs/shared-utils/package.json ./libs/shared-utils/

# Install shopee-admin and its workspace dependencies
RUN pnpm install --frozen-lockfile --filter @shopee/admin...

# -----------------------------------------------------------------------------
# Stage 2: build — compile and bundle with Vite
# -----------------------------------------------------------------------------
FROM deps AS build

# Accept VITE_* build args — Vite inlines these at build time
ARG VITE_API_BASE_URL
ARG VITE_SOCKET_URL
ARG VITE_APP_VERSION
ARG VITE_ENABLE_MOCKS

# Forward build args to ENV so Vite picks them up during vite build
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_ENABLE_MOCKS=$VITE_ENABLE_MOCKS

# Copy the root base tsconfig — apps/shopee-admin/tsconfig.json extends
# ../../tsconfig.base.json, which resolves to /app/tsconfig.base.json inside
# the container. Without this, tsc fails with TS5083 (cannot read file).
COPY tsconfig.base.json ./

# Copy shared libs (required for Vite alias resolution of @shopee/shared-*)
COPY libs/ ./libs/

# Copy the full shopee-admin source
COPY apps/shopee-admin/ ./apps/shopee-admin/

# Build: tsc && vite build — output lands in apps/shopee-admin/dist/
RUN pnpm --filter @shopee/admin run build

# -----------------------------------------------------------------------------
# Stage 3: runtime — serve static assets with brotli-capable Nginx
# Nginx config is embedded inline below (no separate file needed).
# georgjung/nginx-brotli runs as root on port 80 by default; we explicitly
# configure listen 8080 and run as the nginx user (non-root).
# -----------------------------------------------------------------------------
FROM georgjung/nginx-brotli:mainline-alpine AS runtime

# Copy compiled static assets to nginx web root
COPY --from=build /app/apps/shopee-admin/dist /usr/share/nginx/html

# Write the SPA nginx server block config inline.
# Key requirements:
#   - listen 8080 (non-root port, matches compose mapping 127.0.0.1:8082:8080)
#   - SPA fallback: try_files $uri $uri/ /index.html
#   - brotli_static on + gzip_static on for pre-compressed .br/.gz assets
#   - No top-level "user" directive here (this is a server block, not main config)
RUN printf 'server {\n\
    listen 8080;\n\
    server_name _;\n\
\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Serve pre-compressed brotli assets (.br files generated by Vite)\n\
    brotli_static on;\n\
\n\
    # Serve pre-compressed gzip assets (.gz files generated by Vite)\n\
    gzip_static on;\n\
\n\
    # SPA fallback routing — client-side routes return index.html\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    # Cache static assets aggressively (content-hashed filenames)\n\
    location /assets/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
        try_files $uri =404;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

# georgjung/nginx-brotli ships brotli as dynamic modules — they must be loaded
# at the top of the main nginx.conf (main context), or nginx fails at startup
# with: unknown directive "brotli_static". Insert the two load_module lines using
# two separate, portable sed inserts (avoids relying on busybox \n-in-insert-text).
RUN sed -i '1i load_module modules/ngx_http_brotli_filter_module.so;' /etc/nginx/nginx.conf && \
    sed -i '2i load_module modules/ngx_http_brotli_static_module.so;' /etc/nginx/nginx.conf

# Configure nginx to run as non-root:
# 1. Remove the "user" directive from the main nginx.conf so the master process
#    does not attempt to setuid (which requires root). When USER nginx is set,
#    the process already runs as nginx and the "user" directive is disallowed.
# 2. Rewrite any pid directive (regardless of path — /run or /var/run) to
#    /tmp/nginx.pid, which is writable by the nginx user.
# 3. Ensure cache and html directories are writable by the nginx user.
RUN sed -i '/^user /d' /etc/nginx/nginx.conf && \
    sed -i -E 's#^[[:space:]]*pid[[:space:]]+.*;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf && \
    chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

USER nginx

EXPOSE 8080
