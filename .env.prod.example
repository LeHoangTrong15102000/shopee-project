# =============================================================
# Shopee Production Environment Variables
# Copy this file to .env.prod and fill in real values
# =============================================================

# --- MongoDB ---
# Self-hosted mode (--profile self-hosted):
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_URI=mongodb://admin:change_me@mongodb:27017/shopee?authSource=admin
# Cloud mode (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopee?retryWrites=true&w=majority

# --- Redis ---
# Self-hosted mode (--profile self-hosted):
REDIS_URL=redis://redis:6379
# Cloud mode (Redis Cloud):
# REDIS_URL=redis://default:<password>@<host>.redislabs.com:<port>

# --- JWT ---
SECRET_KEY_JWT=change_me_to_64_char_random_string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- App ---
NODE_ENV=production
PORT=4000
CLIENT_URL=https://lehoangtrong.com
UPLOAD_DIR=upload
AUTH_STRICT_MODE=false

# --- Vite build args (used at build time for frontends) ---
# Shared by shopee-web and shopee-admin builds:
VITE_API_BASE_URL=https://api-ecom.lehoangtrong.com
VITE_SOCKET_URL=https://api-ecom.lehoangtrong.com
# shopee-web only:
VITE_SITE_URL=https://lehoangtrong.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_change_me
# shopee-admin only:
VITE_APP_VERSION=1.0.0
