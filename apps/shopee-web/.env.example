# =============================================================================
# Environment Configuration for shopee-web
# Copy this file to .env and fill in the values.
# =============================================================================

# API Base URL - Backend API endpoint
VITE_API_BASE_URL=http://localhost:3000/

# WebSocket URL - Socket.IO server endpoint
VITE_SOCKET_URL=http://localhost:3000

# Site URL - Public URL of this web app
VITE_SITE_URL=http://localhost:3000

# Stripe — publishable key for frontend card element
# Get your key at https://dashboard.stripe.com/apikeys
# Use pk_test_ for development, pk_live_ for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
