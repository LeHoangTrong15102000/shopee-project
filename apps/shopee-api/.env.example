# =============================================================================
# Environment Configuration for shopee-api
# Copy this file to .env and fill in the values.
# =============================================================================

# Application
NODE_ENV=development
PORT=4000

# MongoDB
# For local dev with Docker replica set (required for Mongoose transactions):
#   docker-compose down -v && docker-compose up
# Verify: docker exec shopee-mongodb mongosh -u root -p shopee_root_password --eval "rs.status()"
# The primary member must show "stateStr: PRIMARY".
MONGO_URI=mongodb://root:shopee_root_password@localhost:27017/shopee?replicaSet=rs0&authSource=admin

# JWT — IMPORTANT: SECRET_KEY_JWT must be at least 32 characters.
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY_JWT=change_me_to_a_strong_random_secret_at_least_32_chars

# JWT token TTL (seconds)
# Access token: short-lived (default 900 = 15 minutes)
JWT_ACCESS_TTL=900
# Refresh token: medium-lived (default 2592000 = 30 days)
# Old default was 8640000 (100 days) — reduced for security.
JWT_REFRESH_TTL=2592000

# Client URL (used for CORS)
CLIENT_URL=http://localhost:3000

# Upload directory (relative to project root)
UPLOAD_DIR=upload

# Auth feature flag
# Set to true after 1 week of stable metrics to reject legacy tokens (no jti/roles).
AUTH_STRICT_MODE=false

# Redis Cloud — used for rate limiting.
# Get your free Redis Cloud URL at https://redis.io/cloud/
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=

# Redis individual connection parameters (alternative to REDIS_URL)
REDIS_HOST=your-redis-host.redis.cloud
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_USERNAME=default
REDIS_TLS_ENABLED=false

# Rate limiting — max requests per window per key (all presets share RATE_LIMIT_WINDOW_S)
# Public endpoints (all routes): 200 req/min per IP
RATE_LIMIT_PUBLIC_MAX=200
# Auth endpoints (login, register, forgot/reset password): 15 req/min per IP+email
RATE_LIMIT_AUTH_MAX=15
# Admin endpoints: 300 req/min per authenticated user ID
RATE_LIMIT_ADMIN_MAX=300
# Expensive endpoints (search suggestions): 30 req/min per IP
RATE_LIMIT_EXPENSIVE_MAX=30
# Sliding window duration in seconds (shared by all presets)
RATE_LIMIT_WINDOW_S=60
# Comma-separated IPs that bypass rate limiting (load balancers, monitoring probes)
# Example: RATE_LIMIT_WHITELIST_IPS=127.0.0.1,10.0.0.1
RATE_LIMIT_WHITELIST_IPS=

# Logging
# LOG_FORMAT — output format for log entries.
#   pretty  — chalk-colored human-readable output (default in development)
#   json    — single-line JSON per entry, suitable for log aggregation (default in production)
LOG_FORMAT=pretty

# LOG_LEVEL — minimum severity level to emit.
#   error | warn | info | debug
#   Default: debug in development, info in production.
LOG_LEVEL=debug

# Cache
# CACHE_DRIVER — backing store for the cache service.
#   memory  — in-process Map, no external dependency (default in test)
#   redis   — Redis-backed via REDIS_URL / REDIS_HOST (default in development and production)
# Falls back to memory automatically if CACHE_DRIVER=redis but Redis is unavailable.
CACHE_DRIVER=redis
