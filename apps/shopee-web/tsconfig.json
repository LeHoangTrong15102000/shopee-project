{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "src/*": ["./src/*"],
      "@/lib/*": ["./lib/*"],
      "@/app/*": ["./app/*"],
      "@/test/*": ["./test/*"],
      "@shopee/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@shopee/shared-types/*": ["../../libs/shared-types/src/*"],
      "@shopee/shared-utils": ["../../libs/shared-utils/src/index.ts"],
      "@shopee/shared-utils/*": ["../../libs/shared-utils/src/*"],
      "@shopee/shared-constants": ["../../libs/shared-constants/src/index.ts"],
      "@shopee/shared-constants/*": ["../../libs/shared-constants/src/*"]
    }

    // "types": ["node", "jest", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src", "vitest.setup.js", "src/@types/vitest.d.ts", "../../libs/shared-types/src", "../../libs/shared-constants/src", "../../libs/shared-utils/src"],
  "exclude": ["../../libs/shared-utils/src/**/*.test.ts", "../../libs/shared-utils/src/**/*.spec.ts", "../../libs/shared-utils/src/**/__test__/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
