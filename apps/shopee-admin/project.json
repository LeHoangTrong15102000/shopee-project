{
  "name": "shopee-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shopee-admin/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "apps/shopee-admin"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --port 4001",
        "cwd": "apps/shopee-admin"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --ext ts,tsx src/",
        "cwd": "apps/shopee-admin"
      }
    }
  }
}
